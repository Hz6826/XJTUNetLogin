// Windows version resource, generated from cmake/Version.rc.in by CMake.
// Keep this file ASCII-only so windres never has to deal with a code page.
// FILEVERSION / PRODUCTVERSION must be four comma-separated numbers.

1 VERSIONINFO
 FILEVERSION @APP_RC_FILEVERSION@
 PRODUCTVERSION @APP_RC_FILEVERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hz6826"
            VALUE "FileDescription", "CampusNetLogin"
            VALUE "FileVersion", "@APP_VERSION@"
            VALUE "InternalName", "CampusNetLogin"
            VALUE "LegalCopyright", "Copyright (c) 2026 Hz6826"
            VALUE "OriginalFilename", "CampusNetLogin.exe"
            VALUE "ProductName", "CampusNetLogin"
            VALUE "ProductVersion", "@APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
