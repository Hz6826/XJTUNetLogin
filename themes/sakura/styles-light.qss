/* 樱花 - 浅色 */
QWidget {
    background-color: #fff5f7;
    color: #3a2b30;
}

QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #e8c6cf;
    border-radius: 4px;
    padding: 2px 6px;
    color: #3a2b30;
}

QPushButton {
    background-color: #fbe4ea;
    border: 1px solid #e8c6cf;
    border-radius: 4px;
    padding: 4px 10px;
    color: #3a2b30;
}

QPushButton:hover {
    background-color: #f6d3dd;
}

QCheckBox {
    color: #3a2b30;
}

QGroupBox {
    border: 1px solid #e8c6cf;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #c2185b;
}

QTabWidget::pane {
    border: 1px solid #e8c6cf;
}

QTabBar::tab {
    background: #fbe9ee;
    color: #6b4a55;
    border: 1px solid #e8c6cf;
    border-bottom: none;
    padding: 4px 10px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #ad1457;
}

QScrollBar:vertical {
    background: #fbeef2;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #e8b9c7;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #d99cb0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: #fbeef2;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #e8b9c7;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #d99cb0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
