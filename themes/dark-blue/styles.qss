/* 暗夜蓝：示例主题，演示 styles.qss 的写法 */
QWidget {
    background-color: #1e2430;
    color: #d4d4d4;
}

QLineEdit, QComboBox {
    background-color: #141a24;
    border: 1px solid #3a4a63;
    border-radius: 4px;
    padding: 2px 6px;
    color: #d4d4d4;
}

QPushButton {
    background-color: #263244;
    border: 1px solid #3a4a63;
    border-radius: 4px;
    padding: 4px 10px;
    color: #d4d4d4;
}

QPushButton:hover {
    background-color: #31405a;
}

QCheckBox {
    color: #d4d4d4;
}

QGroupBox {
    border: 1px solid #3a4a63;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #9ecbff;
}

QTabWidget::pane {
    border: 1px solid #3a4a63;
}

QTabBar::tab {
    background: #1a2130;
    color: #c0c8d4;
    border: 1px solid #3a4a63;
    border-bottom: none;
    padding: 4px 10px;
}

QTabBar::tab:selected {
    background: #263244;
    color: #ffffff;
}
